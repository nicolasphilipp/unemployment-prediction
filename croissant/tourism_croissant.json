{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "ml": "http://mlcommons.org/schema/",
    "cr": "http://mlcommons.org/croissant/",
    "sc": "https://schema.org/",
    "recordSet": "ml:recordSet",
    "field": "ml:field",
    "dataType": {
      "@id": "ml:dataType",
      "@type": "@vocab"
    },
    "source": "ml:source",
    "extract": "ml:extract",
    "column": "ml:column"
  },
  "@type": "sc:Dataset",
  "@id": "https://www.data.gv.at/katalog/datasets/ae4ebf87-9f46-4f05-9e3d-dbff002b216d",
  "name": "Guest Overnight Stays Since 2002 - Districts of Vienna",
  "description": "Annual guest overnight stays (absolute and per 1,000 inhabitants) in Vienna districts since 2002, including average population data.",
  "url": "https://www.data.gv.at/katalog/datasets/ae4ebf87-9f46-4f05-9e3d-dbff002b216d",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "sc:Organization",
    "name": "Stadt Wien - Wirtschaft und Finanzen",
    "url": "https://www.wien.gv.at/statistik/"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "tourism_csv",
      "name": "vienna_tourism_since_2002_raw_v1.0.csv",
      "contentUrl": "https://raw.githubusercontent.com/nicolasphilipp/unemployment-prediction/main/data/vienna_tourism_since_2002_raw_v1.0.csv",
      "encodingFormat": "text/csv"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "tourism_records",
      "name": "Tourism Records",
      "field": [
        {
          "@type": "cr:Field",
          "name": "DISTRICT_CODE",
          "description": "Municipality code for Vienna district",
          "dataType": "sc:Integer",
          "source": { "fileObject": { "@id": "tourism_csv" }, "extract": { "column": "DISTRICT_CODE" } }
        },
        {
          "@type": "cr:Field",
          "name": "REF_YEAR",
          "description": "Reference year of the measurement",
          "dataType": "sc:Integer",
          "source": { "fileObject": { "@id": "tourism_csv" }, "extract": { "column": "REF_YEAR" } }
        },
        {
          "@type": "cr:Field",
          "name": "TOU_VALUE",
          "description": "Total guest overnight stays",
          "dataType": "sc:Integer",
          "unitText": "http://qudt.org/vocab/unit/COUNT",
          "source": { "fileObject": { "@id": "tourism_csv" }, "extract": { "column": "TOU_VALUE" } }
        },
        {
          "@type": "cr:Field",
          "name": "TOU_DENSITY",
          "description": "Overnight stays per 1,000 inhabitants",
          "dataType": "sc:Float",
          "unitText": "http://qudt.org/vocab/unit/NUM-PER-HRD",
          "source": { "fileObject": { "@id": "tourism_csv" }, "extract": { "column": "TOU_DENSITY" } }
        },
        {
          "@type": "cr:Field",
          "name": "POP_AVE",
          "description": "Average population in the district",
          "dataType": "sc:Integer",
          "unitText": "http://qudt.org/vocab/unit/Person",
          "source": { "fileObject": { "@id": "tourism_csv" }, "extract": { "column": "POP_AVE" } }
        }
      ]
    }
  ]
}